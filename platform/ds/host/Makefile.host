# Host build of the platform-neutral tier.
#
#   make -f platform/ds/host/Makefile.host
#   make -f platform/ds/host/Makefile.host run
#
# devkitPro is not installed in the development container and cannot be
# installed there (see platform/ds/README.md), so the whole simulation -- fixed
# point, actors, collision, camera, the scene machines -- is built and tested
# with the system compiler against the SNES oracle.  Only rendering, VRAM, input
# and audio need the real toolchain.
#
# The flags mirror the device tier's prohibitions rather than being merely
# strict: no exceptions, no RTTI.  Code that compiles here compiles there.

# Resolve paths from this makefile's own location, so it works from any working
# directory -- agents will invoke it from the repository root.
HERE  := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))
DS    := $(HERE)/..
BUILD := $(HERE)/build

# Where the pipeline puts the DS scene data.  Absolute, resolved from this
# makefile's own location, so a test that loads a real cast table does not depend
# on the working directory the suite happens to be run from.
ASSETS := $(abspath $(HERE)/../../../assets/gen/ds)

CXX      := g++
CXXFLAGS := -std=c++17 -O2 -g \
            -Wall -Wextra -Werror \
            -Wshadow -Wconversion -Wsign-conversion -Wold-style-cast \
            -fno-exceptions -fno-rtti \
            -I$(DS)/include -I$(DS)/device -I$(HERE) \
            -DKH_ASSET_DIR='"$(ASSETS)"'

# -MMD -MP so a header change rebuilds what included it.  Without this, editing
# constants.h relinked stale objects against fresh tests and the suite reported
# 274 failures that were nothing but a mixed build -- the worst kind of red,
# because the code was right and the build was lying.
DEPFLAGS := -MMD -MP

# Globbed, never listed.  Adding a source or a test must not require editing
# this file: eight tasks share it and four of them run concurrently.
SIM  := $(wildcard $(DS)/source/*.cpp) $(wildcard $(DS)/source/*/*.cpp)

# §M7's device tier, MINUS the half that only builds on a DS.
#
# device/ is not under source/ and so is not in SIM, which is deliberate: the
# trace emitter links SIM and must not acquire a dependency on hardware
# registers.  What the host suite CAN build is everything in device/ except
# mmio_device.cpp -- that one is three volatile stores to fixed addresses and
# would segfault here -- with host/mmio_host.cpp linked in its place, recording
# writes instead of performing them.  That substitution is the whole reason the
# initialisation is testable with no toolchain, and it is a LINK seam rather
# than an #ifdef so that neither definition can drift out of sight of the other.
#
# Filtered by name rather than by a list, so device/ can grow without this file
# changing -- and the one file that must never be in a host link is named here
# once, where the reason is written down.
DEVICE := $(filter-out %/mmio_device.cpp,$(wildcard $(DS)/device/*.cpp))
DEVICE_HOST := $(HERE)/mmio_host.cpp

SRCS := $(HERE)/check.cpp $(SIM) $(DEVICE) $(DEVICE_HOST) \
        $(wildcard $(HERE)/tests/*.cpp)
OBJS := $(patsubst %.cpp,$(BUILD)/%.o,$(notdir $(SRCS)))
TARGET := $(BUILD)/hosttests

# The trace emitter -- §M6's DS half.  A second binary rather than a mode of the
# first, because it has its own main() and because a test suite that could be
# made to write a file is a test suite somebody will make write a file.  It
# links the same simulation objects, so the trace and the tests can never be
# describing different builds.
TRACE_OBJS := $(BUILD)/trace_main.o $(patsubst %.cpp,$(BUILD)/%.o,$(notdir $(SIM)))
TRACE := $(BUILD)/dstrace

VPATH := $(HERE) $(HERE)/tests $(DS)/source $(wildcard $(DS)/source/*) \
         $(DS)/device

# Things that MUST NOT COMPILE.  §M0 asked for "a compile-fail check, documented
# not automated" -- `World w = 3;` and `World + Render`.  Documented is where it
# stayed, and a type safety property nothing exercises is a property that has
# already stopped holding by the time anybody notices.  One file per rejection,
# each compiled with -fsyntax-only and required to FAIL.
NOCOMPILE := $(wildcard $(HERE)/nocompile/*.cpp)

# ...and a stamp that changes when the SET of sources does.
#
# Both binaries depend on their objects, and make is right that nothing needs
# rebuilding when a source is DELETED -- every remaining prerequisite is older
# than the target.  So the binary keeps the removed file's cases in it, and the
# suite goes on reporting a count that includes tests whose source is gone.
# Proven by deleting one: 188 cases, from 187 files.
$(shell mkdir -p $(BUILD))
$(shell echo '$(SRCS) $(SIM) $(DEVICE)' | cmp -s - $(BUILD)/.sources \
        || echo '$(SRCS) $(SIM) $(DEVICE)' > $(BUILD)/.sources)
LISTSTAMP := $(BUILD)/.sources

.PHONY: all run trace typecheck clean

all: $(TARGET) $(TRACE)

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/%.o: %.cpp | $(BUILD)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c -o $@ $<

$(TARGET): $(OBJS) $(LISTSTAMP)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS)

$(TRACE): $(TRACE_OBJS) $(LISTSTAMP)
	$(CXX) $(CXXFLAGS) -o $@ $(TRACE_OBJS)

trace: $(TRACE)

# The suite twice: once in registration order and once REVERSED.  Cases share a
# process and a good deal of file-scope state, so a test that only passes
# because an earlier one left something behind is a real and invisible failure
# mode.  Running the same set backwards is the cheapest thing that finds it.
run: $(TARGET) typecheck
	@$(TARGET)
	@$(TARGET) --reverse > /dev/null || { \
	    echo "  the suite passes in registration order and FAILS reversed:"; \
	    $(TARGET) --reverse | grep -E 'FAIL|  in ' | head -20; \
	    echo "  a case is depending on what an earlier one left behind"; \
	    exit 1; }

# ...and the mirror image of NOCOMPILE: files that MUST compile and that nothing
# else in this build would notice if they stopped.
#
# device/mmio_device.cpp is filtered out of DEVICE above because it stores to
# fixed hardware addresses and would fault here.  Which means nothing compiles
# it -- and a source file no build touches is a source file that rots, silently,
# until the day somebody finally has a toolchain and discovers the one half of
# the MMIO seam they could not test is also the half that no longer builds.
# That is this project's recurring defect wearing a new hat, so: syntax-only,
# host compiler, required to SUCCEED.  It contains no libnds and no ARM, so
# there is nothing in it g++ cannot parse; only the volatile stores are
# device-specific, and those are valid C++ anywhere.
MUSTCOMPILE := $(wildcard $(DS)/device/mmio_device.cpp)

# THE LAYERING, checked rather than trusted.
#
# The simulation must not include a device header.  This is not tidiness: it is
# what keeps tools/trace_check.py meaning what it says.  That tool drives both
# machines with the same recorded PAD input and requires identical state, and
# its guarantee is conditional on the pad being the only way in.  A simulation
# source that could read device/touch.h could be moved by something the recorded
# scripts have no column for -- and then "the DS matches the oracle given this
# input" quietly becomes "...with the pen up".
#
# The host build puts -I$(DS)/device on the command line for everything, so the
# compiler will not stop it.  This will.  Tests are exempt: a test SHOULD reach
# into both tiers, that is how the device code is tested at all.
.PHONY: layering
layering:
	@bad=$$(grep -l -E '#include "(mmio|init|ground|ground3d|oam|oam_pack|hud|touch|box|fx|boot)\.h"' \
	        $(DS)/source/*.cpp $(DS)/source/*/*.cpp $(DS)/include/*.h \
	        $(DS)/include/*/*.h 2>/dev/null); \
	if [ -n "$$bad" ]; then \
	    echo "  a simulation source includes a DEVICE header:"; \
	    for f in $$bad; do echo "    $$f"; done; \
	    echo "  the simulation may only be moved by the pad -- see"; \
	    echo "  device/touch.h for why trace_check.py depends on that"; \
	    exit 1; \
	fi; \
	echo "the simulation includes no device header"

typecheck: layering
	@fail=0; n=0; \
	for f in $(NOCOMPILE); do \
	    n=$$((n + 1)); \
	    if $(CXX) $(CXXFLAGS) -fsyntax-only $$f 2> /dev/null; then \
	        echo "  COMPILED AND MUST NOT: $$f"; fail=1; \
	    fi; \
	done; \
	m=0; \
	for f in $(MUSTCOMPILE); do \
	    m=$$((m + 1)); \
	    if ! $(CXX) $(CXXFLAGS) -fsyntax-only $$f; then \
	        echo "  DEVICE-ONLY AND NO LONGER COMPILES: $$f"; \
	        echo "  Nothing links this file here, so nothing else would tell you."; \
	        fail=1; \
	    fi; \
	done; \
	if [ $$fail -ne 0 ]; then exit 1; fi; \
	echo "$$n rejections, all correctly refused by the compiler; \
$$m device-only file(s) still compile"

clean:
	rm -rf $(BUILD)

# EVERY object's dependencies, not just the test binary's.  trace_main.o was in
# TRACE_OBJS and not in OBJS, so its .d file was written on every build and
# included on none of them -- which meant editing trace.h, stage.h, world.h or
# constants.h left the emitter's object stale and nothing said so.
#
# For a TEST binary a stale object shows up as a failing assertion.  For the
# trace emitter it does not: it is the tool the whole oracle comparison trusts,
# and a stale trace_main.o linked against a fresh library disagrees about the
# layout of SceneView and Camera rather than failing to build.  The failure mode
# is not red, it is a trace that is quietly wrong.
-include $(sort $(OBJS:.o=.d) $(TRACE_OBJS:.o=.d))
